--- /dev/null
+++ b/gateway/napcat_memory_context.py
@@ -0,0 +1,17 @@
+"""Optional local-only public context; exact adapter authorization is mandatory."""
+
+
+def local_memory_context(turn):
+    source = turn._ctx.source
+    if source.platform.value != 'napcat' or source.chat_type != 'group':
+        return False
+    adapter = turn._runner._delivery_adapter_for(source)
+    supplier = getattr(adapter, 'public_memory_history_policy', None)
+    if not callable(supplier):
+        return False
+    policy = supplier(source)
+    if policy is None:
+        return False
+    if policy != {'mode': 'local_events', 'contract': 1}:
+        raise ValueError('unsupported public memory history contract')
+    return True
