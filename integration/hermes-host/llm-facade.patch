+"""Read-only parent-process session identity for native and hosted plugins."""
+from __future__ import annotations
+
+from threading import Event
+from typing import Any
+
+from hermes_constants import hermes_home_key
+
+
+class BoundPluginSession:
+    """Resolve the live caller every time, never retain an identity snapshot.
+
+    Hosted callbacks run under the original parent RPC caller context. Detached
+    child work instead reaches PluginHost's empty base context and receives empty
+    fields. Reading ContextVars directly deliberately excludes get_session_env's
+    process-environment fallback.
+    """
+
+    def __init__(self, context: Any):
+        self._context = context
+        self._home = context._manager.scope_key
+        self._closed = Event()
+        context.on_unload(self._closed.set)
+
+    def binding(self) -> dict[str, Any]:
+        if self._closed.is_set() or self._context._load_abandoned:
+            raise PermissionError("plugin session binding has been revoked")
+        if hermes_home_key() != self._home:
+            raise PermissionError("plugin session profile mismatch")
+        return {"contract_version": 1, "plugin_id": self._context.plugin_id,
+                "profile_home": self._home}
+
+    def snapshot(self) -> dict[str, str]:
+        self.binding()
+        from gateway import session_context as ctx
+
+        fields = ("platform", "chat_id", "chat_type", "user_id", "thread_id", "session_id", "message_id")
+        result = {}
+        for field in fields:
+            name = "_SESSION_ID" if field == "session_id" else "_SESSION_" + field.upper()
+            value = getattr(ctx, name).get()
+            result[field] = "" if value is ctx._UNSET else str(value or "")
+        self.binding()
+        return result
