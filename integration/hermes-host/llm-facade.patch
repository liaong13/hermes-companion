+    assert provider is not None
+    fields = ("platform", "chat_id", "chat_type", "user_id", "thread_id", "session_id", "message_id")
+    empty = dict.fromkeys(fields, "")
+    def read(number):
+        expected = dict(platform="napcat", user_id=str(20000+number), chat_id="group:"+str(900+number),
+                        chat_type="group", thread_id="thread-"+str(number),
+                        session_id="session-"+str(number), message_id="message-"+str(number))
+        home_token = set_hermes_home_override(home)
+        tokens = sc.set_session_vars(**expected)
+        try:
+            assert json.loads(provider.read_session()) == expected
+            assert json.loads(provider.detached_session()) == empty
+            return expected["user_id"]
+        finally:
+            for token in reversed(tokens):
+                token.var.reset(token)
+            reset_hermes_home_override(home_token)
+    try:
+        assert json.loads(provider.read_session()) == empty
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            assert list(executor.map(read, range(8))) == [str(20000+number) for number in range(8)]
+        assert json.loads(provider.read_session()) == empty
+    finally:
+        manager = plugins_mod.get_plugin_manager()
+        manager.unload()
