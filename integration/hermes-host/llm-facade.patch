@@ -0,0 +1,66 @@
+"""Profile-bound plugin LLM access for providers and persistent background work."""
+from __future__ import annotations
+
+from threading import Event
+from typing import Any
+
+from hermes_constants import hermes_home_key
+
+
+class BoundPluginLlm:
+    """A host capability revoked on unload, never a credential or context snapshot.
+
+    The owning manager supplies the profile. An ambient profile mismatch is an
+    error rather than a reason to borrow another profile's model configuration.
+    Task ownership is checked against the live registry on every call, so a
+    swallowed registration failure cannot silently select a built-in task.
+    """
+
+    def __init__(self, context: Any):
+        self._context = context
+        self._home = context._manager.scope_key
+        self._closed = Event()
+        context.on_unload(self._closed.set)
+
+    def binding(self, *, task: str | None = None) -> dict[str, Any]:
+        if self._closed.is_set() or self._context._load_abandoned:
+            raise PermissionError("plugin LLM binding has been revoked")
+        if hermes_home_key() != self._home:
+            raise PermissionError("plugin LLM profile mismatch")
+        if task is not None and (not isinstance(task, str) or not task):
+            raise ValueError("task must be a nonempty string or None")
+        manager = self._context._manager
+        with manager._discovery_lock:
+            entry = manager._aux_tasks.get(task) if task else None
+            registered = entry is not None and entry.get("plugin") == self._context.plugin_id
+        return {"contract_version": 1, "plugin_id": self._context.plugin_id,
+                "profile_home": self._home, "task": task, "task_registered": registered}
+
+    def _check(self, task: str | None) -> None:
+        binding = self.binding(task=task)
+        if task is not None and not binding["task_registered"]:
+            raise PermissionError("plugin LLM auxiliary task is not registered by this plugin")
+
+    def _complete(self, method: str, args: tuple, kwargs: dict) -> Any:
+        self._check(kwargs.get("task"))
+        result = getattr(self._context.llm, method)(*args, **kwargs)
+        self._check(kwargs.get("task"))
+        return result
+
+    async def _acomplete(self, method: str, args: tuple, kwargs: dict) -> Any:
+        self._check(kwargs.get("task"))
+        result = await getattr(self._context.llm, method)(*args, **kwargs)
+        self._check(kwargs.get("task"))
+        return result
+
+    def complete(self, *args: Any, **kwargs: Any) -> Any:
+        return self._complete("complete", args, kwargs)
+
+    def complete_structured(self, *args: Any, **kwargs: Any) -> Any:
+        return self._complete("complete_structured", args, kwargs)
+
+    async def acomplete(self, *args: Any, **kwargs: Any) -> Any:
+        return await self._acomplete("acomplete", args, kwargs)
+
+    async def acomplete_structured(self, *args: Any, **kwargs: Any) -> Any:
+        return await self._acomplete("acomplete_structured", args, kwargs)
