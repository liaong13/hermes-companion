+    (plugin / "plugin.yaml").write_text("name: boundprobe\nversion: 1.0\n", encoding="utf-8")
+    (home / "config.yaml").write_text("plugins:\n  isolation: " + isolation + "\n", encoding="utf-8")
+    monkeypatch.setenv("HOME", str(tmp_path / "os-home"))
