+"""Provider-only discovery reaches the real profile-bound facade, also across RPC."""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import time
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_constants import hermes_home_key, reset_hermes_home_override, set_hermes_home_override
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+
+BODY = '''
+import json, os, threading
+from agent.memory_provider import MemoryProvider
+
+class Probe(MemoryProvider):
+    @property
+    def name(self): return "boundprobe"
+    def is_available(self): return True
+    def initialize(self, session_id, **kwargs): pass
+    def get_tool_schemas(self): return []
+    def terminate_for_test(self): os._exit(3)
+    def read_session(self): return json.dumps(self.reader.snapshot())
+    def detached_session(self):
+        results = []
+        worker = threading.Thread(target=lambda: results.append(self.reader.snapshot()))
+        worker.start()
+        worker.join(timeout=5)
+        if worker.is_alive(): raise RuntimeError("detached probe timed out")
+        return json.dumps(results[0])
+    def prefetch(self, query, **kwargs):
+        binding = self.service.binding(task="boundprobe_extract")
+        reply = self.service.complete_structured(instructions="synthetic", input=[], task="boundprobe_extract")
+        return json.dumps({"binding": binding, "reply": reply, "provider_pid": os.getpid()})
+
+def register(ctx):
+    ctx.register_auxiliary_task("boundprobe_extract", display_name="Probe", description="synthetic")
+    provider = Probe()
+    provider.service = ctx.bound_llm
+    provider.reader = ctx.bound_session
+    ctx.register_memory_provider(provider)
+'''
+
+
+def context(home):
+    manager = PluginManager(scope_key=str(home))
+    ctx = PluginContext(PluginManifest(name="boundprobe", key="boundprobe"), manager)
+    ctx.register_auxiliary_task("boundprobe_extract", display_name="Probe", description="synthetic")
+    return ctx, manager
+
+
+def test_binding_rejects_wrong_profile_unregistered_task_and_unloaded_context(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    ctx, manager = context(tmp_path)
+    service = ctx.bound_llm
+    reader = ctx.bound_session
+    binding = service.binding(task="boundprobe_extract")
+    assert binding == {"contract_version": 1, "plugin_id": "boundprobe", "profile_home": hermes_home_key(tmp_path),
+                       "task": "boundprobe_extract", "task_registered": True}
+    assert reader.binding() == {"contract_version": 1, "plugin_id": "boundprobe", "profile_home": hermes_home_key(tmp_path)}
+    assert service.binding(task="missing")["task_registered"] is False
+    ctx._llm = SimpleNamespace(complete=lambda **kw: pytest.fail("must not call model"))
+    with pytest.raises(PermissionError):
+        service.complete(task="missing")
+    manager._aux_tasks["boundprobe_extract"]["plugin"] = "another-plugin"
+    assert service.binding(task="boundprobe_extract")["task_registered"] is False
+    with pytest.raises(PermissionError):
+        service.complete(task="boundprobe_extract")
+    token = set_hermes_home_override(tmp_path / "other-profile")
+    try:
+        with pytest.raises(PermissionError):
+            service.binding(task="boundprobe_extract")
+        with pytest.raises(PermissionError):
+            reader.snapshot()
+    finally:
+        reset_hermes_home_override(token)
+    manager.unload("boundprobe")
+    with pytest.raises(PermissionError):
+        service.binding(task="boundprobe_extract")
+    with pytest.raises(PermissionError):
+        reader.snapshot()
+
+
+def test_sync_and_async_results_are_rejected_when_binding_revoked_during_call(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    ctx, manager = context(tmp_path)
+    service = ctx.bound_llm
+    async def revoke_async(**kwargs):
+        manager.unload("boundprobe")
+        return "late result"
+    ctx._llm = SimpleNamespace(acomplete_structured=revoke_async)
+    with pytest.raises(PermissionError):
+        asyncio.run(service.acomplete_structured(task="boundprobe_extract"))
+    ctx, manager = context(tmp_path)
+    service = ctx.bound_llm
+    def revoke_sync(**kwargs):
+        manager.unload("boundprobe")
+        return "late result"
+    ctx._llm = SimpleNamespace(complete=revoke_sync)
+    with pytest.raises(PermissionError):
+        service.complete(task="boundprobe_extract")
+
+
+@pytest.mark.parametrize("isolation", ["in_process", "host"])
+@pytest.mark.parametrize("general_first", [False, True])
+def test_provider_only_discovery_binds_actual_task_home_and_facade_over_rpc(tmp_path, monkeypatch, isolation, general_first):
+    from agent.plugin_llm import PluginLlm
+    from hermes_cli import plugins as plugins_mod
+    from plugins.memory import load_memory_provider
+
+    home = tmp_path / "profile"
+    plugin = home / "plugins" / "boundprobe"
+    plugin.mkdir(parents=True)
+    (plugin / "plugin.yaml").write_text("name: boundprobe\nversion: 1.0\nkind: standalone\n", encoding="utf-8")
+    (plugin / "__init__.py").write_text(BODY, encoding="utf-8")
+    (home / "config.yaml").write_text("plugins:\n  isolation: " + isolation + "\n  enabled: [boundprobe]\n", encoding="utf-8")
+    monkeypatch.setenv("HOME", str(tmp_path / "os-home"))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    bundled = tmp_path / "bundled"
+    bundled.mkdir()
+    monkeypatch.setattr(plugins_mod, "get_bundled_plugins_dir", lambda: bundled)
+    calls = []
+    def fake_call(self, **kwargs):
+        calls.append(kwargs)
+        return {"parsed": {"synthetic": True}, "home": hermes_home_key()}
+    monkeypatch.setattr(PluginLlm, "complete_structured", fake_call)
+    if general_first:
+        manager = plugins_mod.get_plugin_manager()
+        manager.discover_and_load()
+        assert manager._plugins["boundprobe"].enabled is True
+    provider = load_memory_provider("boundprobe")
+    assert provider is not None
+    try:
+        result = json.loads(provider.prefetch("synthetic"))
+        assert result["binding"]["task_registered"] is True
+        assert result["binding"]["profile_home"] == hermes_home_key(home)
+        assert result["binding"]["plugin_id"] == "boundprobe"
+        assert result["reply"] == {"parsed": {"synthetic": True}, "home": hermes_home_key(home)}
+        assert (result["provider_pid"] == os.getpid()) == (isolation == "in_process")
+        assert calls == [{"instructions": "synthetic", "input": [], "task": "boundprobe_extract"}]
+        if isolation == "host":
+            host = plugins_mod.get_plugin_manager()._plugin_host()
+            with pytest.raises(Exception):
+                provider.terminate_for_test()
+            deadline = time.monotonic() + 5
+            while host.alive and time.monotonic() < deadline:
+                time.sleep(0.01)
+            reloaded = json.loads(provider.prefetch("synthetic after restart"))
+            assert reloaded["provider_pid"] not in {result["provider_pid"], os.getpid()}
+            assert reloaded["binding"] == result["binding"]
+    finally:
+        manager = plugins_mod.get_plugin_manager()
+        manager.unload()
+        if isolation == "host":
+            manager._plugin_host().shutdown()
+
+
+@pytest.mark.parametrize("isolation", ["in_process", "host"])
+def test_live_session_identity_is_task_local_environment_free_and_absent_for_detached_work(tmp_path, monkeypatch, isolation):
+    from gateway import session_context as sc
+    from hermes_cli import plugins as plugins_mod
+    from plugins.memory import load_memory_provider
+
