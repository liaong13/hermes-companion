+def test_group_approval_never_renders():
+    runner = object.__new__(TurnRunner)
+    runner._ctx = SimpleNamespace(source=SimpleNamespace(
+        platform=SimpleNamespace(value='napcat'), chat_type='group'))
+    with patch.object(TurnRunner, '_render_approval_sync') as render:
+        with pytest.raises(RuntimeError, match='group_approval_denied'):
+            runner._approval_notify_sync({'command': 'private'})
+    render.assert_not_called()
+
