+"""A turn authority is enforced at the registry dispatch, including direct callers."""
+from unittest.mock import patch
+from types import SimpleNamespace
+
+from agent.tool_authority import bind_tool_authority
+from agent import tool_executor
+import model_tools
+from agent.agent_init import _init_memory
+
+
+def test_direct_dispatch_refuses_before_handler():
+    with patch.object(model_tools, "_pre_dispatch_guards", side_effect=lambda name, args, *rest: (args, None)), \
+         patch.object(model_tools, "_execute_tool", return_value='{"secret":"leak"}') as execute:
+        with bind_tool_authority(lambda name, args: "denied"):
+            result = model_tools.handle_function_call(
+                "web_search", {"query": "private"}, skip_pre_tool_call_hook=True,
+                skip_tool_request_middleware=True, skip_tool_execution_middleware=True,
+            )
+    assert "denied" in result
+    execute.assert_not_called()
+
+
+def test_authority_exception_refuses_before_handler():
+    def broken(name, args):
+        raise RuntimeError("sensitive detail")
+
+    with patch.object(model_tools, "_pre_dispatch_guards", side_effect=lambda name, args, *rest: (args, None)), \
+         patch.object(model_tools, "_execute_tool") as execute:
+        with bind_tool_authority(broken):
+            result = model_tools.handle_function_call(
+                "web_extract", {"urls": ["https://example.org"]},
+                skip_pre_tool_call_hook=True, skip_tool_request_middleware=True,
+                skip_tool_execution_middleware=True,
+            )
+    assert "tool_authorization_unavailable" in result
+    assert "sensitive detail" not in result
+    execute.assert_not_called()
+
+
+def test_agent_dispatch_refuses_rewritten_arguments():
+    state = tool_executor._ManagedToolResult(None, {}, [], False, False)
+    ref = tool_executor._ToolCallRef('terminal', {'command': 'safe'}, 'task', 'call', [])
+    with patch.object(tool_executor, '_pre_tool_block', return_value=(None, {'command': 'private'})), \
+         patch.object(tool_executor, '_emit_terminal_post_tool_call'):
+        with bind_tool_authority(lambda name, args: 'denied' if args['command'] == 'private' else None):
+            result = tool_executor._dispatch_authorized_once(
+                object(), state, ref, execute=lambda args: (_ for _ in ()).throw(AssertionError('executed')),
+                scope_block=None, display_index=None, begin_execution=None, authorization_gate=None,
+            )
+    assert state.blocked
+    assert 'denied' in result
+
+
+def test_direct_middleware_rewrite_is_rechecked():
+    ids = model_tools._CallIds('task', 'session', 'call', 'turn', 'request')
+    def rewrite(name, args, dispatch, **kwargs):
+        return dispatch({'command': 'private'})
+
+    with patch('hermes_cli.middleware.run_tool_execution_middleware', side_effect=rewrite), \
+         patch.object(model_tools.registry, 'dispatch') as dispatch:
+        with bind_tool_authority(lambda name, args: 'denied' if args['command'] == 'private' else None):
+            result = model_tools._execute_tool('terminal', {'command': 'safe'},
+                                               {'command': 'safe'}, ids, user_task=None,
+                                               enabled_tools=None, skip_tool_execution_middleware=False)
+    assert 'denied' in result
+    dispatch.assert_not_called()
+
+
+def test_group_keeps_memory_schema_without_loading_private_store():
+    agent = SimpleNamespace(enabled_toolsets=['memory'], disabled_toolsets=[], _chat_type='group',
+                            tools=[{'type': 'function', 'function': {'name': 'memory'}}],
+                            valid_tool_names={'memory'})
+    with patch('agent.safe_worker_policy.safe_worker_enabled', return_value=False), \
+         patch('tools.memory_tool.MemoryStore.load_from_disk') as load, \
+         patch('tools.memory_tool.get_builtin_memory_config', return_value={'provider': 'mem0'}), \
+         patch('plugins.memory.load_memory_provider') as provider_load:
+        provider_load.return_value.is_available.return_value = True
+        provider_load.return_value.get_tool_schemas.return_value = [
+            {'name': 'mem0_search', 'description': 'search', 'parameters': {'type': 'object'}}]
+        _init_memory(agent, {}, True, 'napcat')
+    assert agent._memory_store is None
+    assert agent._memory_manager is None
+    assert 'mem0_search' in agent.valid_tool_names
+    provider_load.assert_called_once_with('mem0', register_skills=False)
+    load.assert_not_called()
