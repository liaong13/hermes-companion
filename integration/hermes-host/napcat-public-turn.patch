+from gateway.session_context_refs import turn_references
+
+
+class _Runner(GatewayInboundMixin):
+    config = SimpleNamespace(multiplex_profiles=False)
+
+    def __init__(self, adapter):
+        self.adapter = adapter
+
+    def _scale_to_zero_note_real_inbound(self):
+        pass
+
+    async def _hm_pre_gateway_dispatch_hook(self, event, source):
+        return event
+
+    def _intake_adapter_for(self, source):
+        return self.adapter
+
+    def _is_user_authorized_for_source(self, source):
+        raise AssertionError('profile allowlist cannot replace the NapCat receipt')
+
+    def _admit_bot_message_for_source(self, source):
+        return True
+
+
+def test_live_adapter_receipt_required():
+    source = SimpleNamespace(platform=SimpleNamespace(value='napcat'), chat_type='group',
+                             chat_id='group:20001', user_id='10001', user_name='member',
+                             profile=None, profile_route_rejected=False)
+    event = SimpleNamespace(source=source, internal=False, _fifo_only=False,
+                            _bot_loop_admitted=False)
+    adapter = SimpleNamespace(admit_group_source=lambda src: src is source)
+    runner = _Runner(adapter)
+    with patch.dict(sys.modules, {'gateway.run': SimpleNamespace(_is_slack_ignored_channel=lambda *a: False)}):
+        assert asyncio.run(runner._hm_admit_event(event)) == (event, source, False)
+        adapter.admit_group_source = lambda src: False
+        assert asyncio.run(runner._hm_admit_event(event)) is None
+        adapter.admit_group_source = lambda src: (_ for _ in ()).throw(RuntimeError('bad'))
+        assert asyncio.run(runner._hm_admit_event(event)) is None
+
