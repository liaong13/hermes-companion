diff --git a/agent/tool_authority.py b/agent/tool_authority.py
new file mode 100644
index 0000000000..06089f5d3b
--- /dev/null
+++ b/agent/tool_authority.py
@@ -0,0 +1,38 @@
+"""Mandatory, turn-scoped authorization at actual tool dispatch boundaries."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_authority = ContextVar("hermes_tool_authority", default=None)
+
+
+@contextmanager
+def bind_tool_authority(authority):
+    token = _authority.set(authority)
+    try:
+        yield
+    finally:
+        _authority.reset(token)
+
+
+def check_tool_authority(name, arguments):
+    """Return a safe refusal, or None. An authority error always refuses execution."""
+    authority = _authority.get()
+    if authority is None:
+        return None
+    try:
+        decision = authority(name, arguments)
+        if decision is None:
+            return None
+        return str(decision) if decision else "tool_authorization_denied"
+    except Exception:
+        return "tool_authorization_unavailable"
+
+
+def record_authorized_result(name, result):
+    authority = _authority.get()
+    recorder = getattr(authority, "record_result", None)
+    if recorder is not None:
+        try:
+            recorder(name, result)
+        except Exception:
+            pass  # An output receipt cannot expand authority on failure.
