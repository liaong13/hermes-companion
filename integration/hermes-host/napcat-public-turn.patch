+@pytest.mark.asyncio
+async def test_public_group_keeps_local_and_plugin_references_literal(tmp_path):
+    private = tmp_path / 'private.txt'
+    private.write_text('PRIVATE_CANARY')
+    source = SimpleNamespace(platform=SimpleNamespace(value='napcat'), chat_type='group',
+                             _napcat_public_turn=True)
+    event = SimpleNamespace(message_id='7')
+    message = f'@小明 请看 @file:{private} @folder:{tmp_path} @git:HEAD @plugin:secret'
+    with patch('gateway.session_context_refs.inbound_references', side_effect=AssertionError('expanded')):
+        result = await turn_references(object(), event, source, 'group:7', message)
+    assert result == message
+    assert 'PRIVATE_CANARY' not in result
